# ==============================================================================
# Ahmad Hassan — AI Developer Portfolio Environment Variables (Example)
# ==============================================================================
# IMPORTANT:
# - Do NOT place real API keys or secrets in this example file.
# - Copy this file to `.env.local` for local development.
# - All keys listed below are server-side only and never exposed to the client.
# ==============================================================================

# Option A: Google Gemini REST API Key (Optional)
# If provided, Ahmad's AI Guide will query Gemini 1.5 Flash grounded in portfolio data.
# If omitted or invalid, the assistant automatically uses the verified local FAQ fallback.
GEMINI_API_KEY=your_gemini_api_key_here

# Option B: OpenAI API Key (Optional alternative)
OPENAI_API_KEY=your_openai_api_key_here
